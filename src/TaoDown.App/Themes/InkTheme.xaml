<?xml version="1.0" encoding="utf-8"?>
<!--
    水墨主题（默认自带）：近白宣底 #FCFBF7、浓墨字、黛青点缀。
    v2.49 对齐 Tao 系列母本标准（TaoPad/TaoZip 同源宣纸白）：此前 #F7F5EE 偏淡黄，
    按同系标准整体提白：底 #FCFBF7 / 次底 #ECEAE2 / 内容层 #FEFDFB，保持同键同义不同值。
    Tao 系列主题铁律: 扁平键值(禁 ThemeDictionaries 分段), 三字典键集完全一致,
    亮度阶梯: 水墨浅 > 天青釉 > 墨夜黑, 同键同义不同值。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 底与层: 页面底/基础层/层色底(内容区必带) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#ECEAE2" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FEFDFB" />

    <!-- 标题栏三件 -->
    <SolidColorBrush x:Key="WindowCaptionBackgroundBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="WindowCaptionForegroundBrush" Color="#1C242C" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabledBrush" Color="#F3F1EA" />

    <!-- 文字四档 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1C242C" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6F6A5E" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C867A" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#A8A296" />

    <!-- 点缀 -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#52708A" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#41586E" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#374B5F" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4F6C86" />

    <!-- 控件与描边 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FDFCF8" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F7F5F0" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#A89F8C" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#B5AD99" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#A49E91" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#A49E91" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#ECEAE2" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#E4E2DA" />

    <!-- 侧边导航: 窗格 #F2F0EA 略深于近白底, 条目悬停/选中 #ECEAE2 与次底同源 -->
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F2F0EA" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackgroundBrush" Color="#F2F0EA" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FCFBF7" />
    <SolidColorBrush x:Key="NavigationViewContentBackgroundBrush" Color="#FCFBF7" />

    <!-- 系统强调色整体改绑(切换随象) -->
    <Color x:Key="SystemAccentColor">#52708A</Color>
    <Color x:Key="SystemAccentColorLight1">#6C859C</Color>
    <Color x:Key="SystemAccentColorLight2">#869BAD</Color>
    <Color x:Key="SystemAccentColorLight3">#A0B0BF</Color>
    <Color x:Key="SystemAccentColorDark1">#465F75</Color>
    <Color x:Key="SystemAccentColorDark2">#394E61</Color>
    <Color x:Key="SystemAccentColorDark3">#2D3E4C</Color>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#6C859C" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#869BAD" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#A0B0BF" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#465F75" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#394E61" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#2D3E4C" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#52708A" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#52708A" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#52708A" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#52708A" />
    <!-- 导航三态(2026-11-02 墨夜适配): 文字/悬停/按下/选中/选中指示全部跟象而变,
         键名与 WinUI NavigationView 模板消费的键完全一致, 三字典同键同义不同值 -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1C242C" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#1C242C" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#6F6A5E" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="#A8A296" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#1C242C" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#ECEAE2" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#E4E2DA" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#ECEAE2" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#52708A" />

</ResourceDictionary>
