<?xml version="1.0" encoding="utf-8"?>
<!--
    天青主题（按 2026-11-06 用户定稿对齐 TaoAgent 天青色板）：
    天青釉底 #EDF2EF（近白偏青，冷而不钢）、墨青文字 #2B3A36、青瓷点缀 #2C534C。
    陶瓷质感：卡片面（LayerFill）与控件面（ControlFillDefault）为纵向釉面微渐变（上亮-主体-下暗，±6%）。
    Tao 系列主题铁律: 扁平键值(禁 ThemeDictionaries 分段), 三字典键集完全一致,
    亮度阶梯: 水墨浅 > 天青釉 > 墨夜黑, 同键同义不同值。
    点缀定档说明: 青瓷主色 #34655C 与水墨象点缀 #52708A 对比仅 1.28，违反「三象点缀两两互异」
    视觉之道（≥1.5），故取同族深一档 #2C534C（对比 1.65）——守住铁律，保住青瓷气质。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 底与层: 页面底/基础层/层色底(内容区必带) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#EDF2EF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#EDF2EF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#E1E9E4" />
    <LinearGradientBrush x:Key="LayerFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#FAFCFA" Offset="0.55" />
        <GradientStop Color="#F2F0F2" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 标题栏三件 -->
    <SolidColorBrush x:Key="WindowCaptionBackgroundBrush" Color="#EDF2EF" />
    <SolidColorBrush x:Key="WindowCaptionForegroundBrush" Color="#2B3A36" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabledBrush" Color="#E1E9E4" />

    <!-- 文字四档: 墨青系 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#2B3A36" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4A5A54" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#64746E" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#9AA8A1" />

    <!-- 点缀: 青瓷 (与水墨青灰蓝、墨夜黛青两两互异) -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2C534C" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#254741" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1E3B36" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#254741" />

    <!-- 控件与描边: 控件面走陶瓷渐变, 描边深青锁边界 -->
    <LinearGradientBrush x:Key="ControlFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#F3F8F4" Offset="0.55" />
        <GradientStop Color="#E7ECE8" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E7EDE8" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#8FA39A" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#97A99F" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#8FA39A" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#8FA39A" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#DFE7E3" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#D5DEDA" />

    <!-- 侧边导航 -->
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#E1E9E4" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackgroundBrush" Color="#E1E9E4" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#EDF2EF" />
    <SolidColorBrush x:Key="NavigationViewContentBackgroundBrush" Color="#EDF2EF" />

    <!-- 系统强调色整体改绑(切换随象) -->
    <Color x:Key="SystemAccentColor">#2C534C</Color>
    <Color x:Key="SystemAccentColorLight1">#466E64</Color>
    <Color x:Key="SystemAccentColorLight2">#668A80</Color>
    <Color x:Key="SystemAccentColorLight3">#8CA89E</Color>
    <Color x:Key="SystemAccentColorDark1">#254741</Color>
    <Color x:Key="SystemAccentColorDark2">#1E3B36</Color>
    <Color x:Key="SystemAccentColorDark3">#172E2A</Color>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#466E64" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#668A80" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#8CA89E" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#254741" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#1E3B36" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#172E2A" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2C534C" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#2C534C" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#2C534C" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#2C534C" />
    <!-- 导航三态: 文字/悬停/按下/选中/选中指示全部跟象而变,
         键名与 WinUI NavigationView 模板消费的键完全一致, 三字典同键同义不同值 -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#2B3A36" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#3E6A61" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#466E64" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="#9AA8A1" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#2C534C" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#DDE6DF" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#D2DCD6" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#DDE6DF" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2C534C" />

</ResourceDictionary>
