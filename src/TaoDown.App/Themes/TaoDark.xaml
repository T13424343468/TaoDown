<?xml version="1.0" encoding="utf-8"?>
<!--
    墨夜主题：暖炭近黑底 #131211、宣纸白字、黛青亮版点缀（对齐 TaoPad/TaoZip 墨夜母本）。
    Tao 系列主题铁律: 扁平键值(禁 ThemeDictionaries 分段), 三字典键集完全一致,
    亮度阶梯: 水墨浅 > 天青釉 > 墨夜黑, 同键同义不同值。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 底与层: 页面底/基础层/层色底(内容区必带) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#131211" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#131211" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#191715" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1C1A18" />

    <!-- 标题栏三件 -->
    <SolidColorBrush x:Key="WindowCaptionBackgroundBrush" Color="#131211" />
    <SolidColorBrush x:Key="WindowCaptionForegroundBrush" Color="#E8E3D5" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabledBrush" Color="#191715" />

    <!-- 文字四档 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E8E3D5" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B5AFA0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C8678" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C574C" />

    <!-- 点缀 -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#6FA3BC" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5C8DA6" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4A768E" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#6FA3BC" />

    <!-- 控件与描边 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#211E1B" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#191715" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#5C554B" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#6A6357" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#5C554B" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#5C554B" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#26221E" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#2D2823" />

    <!-- 侧边导航 -->
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#191715" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackgroundBrush" Color="#191715" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#131211" />
    <SolidColorBrush x:Key="NavigationViewContentBackgroundBrush" Color="#131211" />

    <!-- 系统强调色整体改绑(切换随象) -->
    <Color x:Key="SystemAccentColor">#6FA3BC</Color>
    <Color x:Key="SystemAccentColorLight1">#83B1C8</Color>
    <Color x:Key="SystemAccentColorLight2">#97BFD4</Color>
    <Color x:Key="SystemAccentColorLight3">#ABCFE0</Color>
    <Color x:Key="SystemAccentColorDark1">#5C8DA6</Color>
    <Color x:Key="SystemAccentColorDark2">#4A768E</Color>
    <Color x:Key="SystemAccentColorDark3">#386076</Color>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#83B1C8" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#97BFD4" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#ABCFE0" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#5C8DA6" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#4A768E" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#386076" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#6FA3BC" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#6FA3BC" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#6FA3BC" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#6FA3BC" />
    <!-- 导航三态(2026-11-02 墨夜适配): 文字/悬停/按下/选中/选中指示全部跟象而变,
         键名与 WinUI NavigationView 模板消费的键完全一致, 三字典同键同义不同值 -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#E8E3D5" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#E8E3D5" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#B5AFA0" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="#5C574C" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#E8E3D5" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#26221E" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#2D2823" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#26221E" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#6FA3BC" />

</ResourceDictionary>
