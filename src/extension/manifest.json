{
  "manifest_version": 3,
  "name": "TaoDown 接管助手",
  "description": "把浏览器下载转交给 TaoDown：点下载即弹出保存位置，支持右键「用 TaoDown 下载」，blob/data 网页内文件也能接。",
  "version": "1.2.11",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TaoDown 下载接管"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
