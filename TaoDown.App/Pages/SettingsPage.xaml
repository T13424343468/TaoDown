<Page
    x:Class="TaoDown.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <ScrollViewer x:Name="RootScroll" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="界面主题" Style="{StaticResource SubtitleTextBlockStyle}" />
            <RadioButtons x:Name="ThemeBox" MaxColumns="3" SelectionChanged="OnThemeChanged">
                <RadioButton Content="水墨（默认）" />
                <RadioButton Content="浅色" />
                <RadioButton Content="深色" />
            </RadioButtons>

            <TextBlock Text="下载设置" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

            <TextBox
                x:Name="DownloadDirBox"
                Header="下载根目录"
                PlaceholderText="如 D:\\Program Files\\Downloads\\TaoDown" />

            <NumberBox
                x:Name="MaxConcurrentBox"
                Header="同时下载任务数"
                Minimum="1"
                Maximum="16"
                SpinButtonPlacementMode="Compact"
                Value="3" />

            <NumberBox
                x:Name="SpeedLimitBox"
                Header="全局速度上限（KB/s，0 = 不限速）"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                Value="0" />

            <ToggleSwitch
                x:Name="AutoClassifySwitch"
                Header="自动按类型分目录（视频/音频/压缩包/文档/安装包/图片）"
                OnContent="开"
                OffContent="关" />

            <ToggleSwitch
                x:Name="ClipboardMonitorSwitch"
                Header="剪贴板监视（复制链接自动填入下载页）"
                OnContent="开"
                OffContent="关" />

            <TextBlock Text="托盘与退出" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBlock
                Text="决定点窗口右上角关闭按钮时的行为。选「最小化到托盘」时下载继续，托盘图标可暂停/继续全部任务、查看实时速度、退出程序；选「直接退出」则停止全部任务并收起托盘。关闭时若选「每次询问」，每次都会弹窗让你定。"
                Opacity="0.7"
                TextWrapping="Wrap" />
            <RadioButtons
                x:Name="CloseBehaviorBox"
                Header="关闭主窗口时"
                MaxColumns="1">
                <RadioButton Content="每次询问" />
                <RadioButton Content="最小化到托盘（下载继续）" />
                <RadioButton Content="直接退出" />
            </RadioButtons>

            <TextBlock Text="接管与自启" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <ToggleSwitch
                x:Name="ProtocolTakeoverSwitch"
                Header="链接接管（磁力 / 电骡 / 迅雷 / 种子）"
                OnContent="开"
                OffContent="关" />
            <ToggleSwitch
                x:Name="StartWithWindowsSwitch"
                Header="开机自启"
                OnContent="开"
                OffContent="关" />

            <ToggleSwitch
                x:Name="BrowserTakeoverSwitch"
                Header="浏览器下载接管"
                OnContent="开"
                OffContent="关" />

            <TextBox
                x:Name="ExtensionStoreUrlBox"
                Header="插件商店链接（上架后填）"
                PlaceholderText="如 https://clients2.google.com/service/update2/crx" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="MountBrowsersButton" Content="挂载接管通道" Click="OnMountBrowsers" />
                <Button x:Name="OpenExtFolderButton" Content="打开插件文件夹" Click="OnOpenExtensionFolder" />
            </StackPanel>
            <TextBlock
                Text="接管说明：装好后重启浏览器，插件自动挂载；若未自动挂载，开「开发者模式」→「加载已解压的扩展程序」→ 选「打开插件文件夹」里的目录。"
                Opacity="0.7"
                TextWrapping="Wrap" />

            <NumberBox
                x:Name="SeedMinutesBox"
                Header="BT 做种时长（分钟，0 = 不做种）"
                Minimum="0"
                Maximum="10080"
                SpinButtonPlacementMode="Compact"
                Value="0" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="保存设置" Click="OnSaveSettings" />
                <Button x:Name="OpenFolderButton" Content="打开下载目录" Click="OnOpenFolder" />
            </StackPanel>

            <TextBlock
                x:Name="PageStatus"
                Text=""
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
